# Copy to /etc/osai/bot.env on the server and fill in. Never commit the real file.

# Telegram bot token from @BotFather
OSAI_TELEGRAM_BOT_TOKEN=

# ---- AI model connection: pick ONE block ----

# A) OpenRouter (default). Free models end in ":free"; see openrouter.ai/models.
OSAI_LLM_PRESET=openrouter
OSAI_LLM_API_KEY=
OSAI_LLM_MODEL=

# B) Any other preset: openai | groq | gemini | deepseek | mistral | together | anthropic
# OSAI_LLM_PRESET=gemini
# OSAI_LLM_API_KEY=
# OSAI_LLM_MODEL=

# C) Local model, no key (Ollama / LM Studio on the same server)
# OSAI_LLM_PRESET=ollama
# OSAI_LLM_MODEL=qwen2.5:7b

# D) Any OpenAI-compatible endpoint
# OSAI_LLM_PRESET=custom
# OSAI_LLM_BASE_URL=https://example.com/v1
# OSAI_LLM_MODEL=
# OSAI_LLM_API_KEY=
# Key in a custom header instead of "Authorization: Bearer":
# OSAI_LLM_AUTH=header
# OSAI_LLM_AUTH_HEADER=api-key

# E) Sign-in token instead of a key (e.g. Google Vertex, Azure AD)
# OSAI_LLM_AUTH=command
# OSAI_LLM_TOKEN_COMMAND=gcloud auth print-access-token
# OSAI_LLM_TOKEN_TTL=300

# Optional
# OSAI_LLM_TIMEOUT=60
# OSAI_LLM_JSON_MODE=1
