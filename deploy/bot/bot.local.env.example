# Minimal settings for the local browser chat (python -m osai.bot web).
# Only an AI connection is required; Telegram and Google are not needed.

OSAI_CATALOG_PATH=deploy/bot/catalog.local.example.json

# AI model (OpenRouter free model by default; any preset works, see bot.env.example)
OSAI_LLM_PRESET=openrouter
OSAI_LLM_API_KEY=
OSAI_LLM_MODEL=

# Voice is not used by the browser chat
OSAI_STT=off
